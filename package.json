  "dependencies": {
    "@hirosystems/clarinet-sdk": "^3.8.1",
    "@stacks/transactions": "^7.6.0",
    "@stacks/wallet-sdk": "^6.17.0",
    "chokidar-cli": "^3.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1",
    "vitest-environment-clarinet": "^3.0.2"
  }
}
